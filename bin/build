#!/bin/sh -e

#!/bin/sh -e

node_modules/.bin/tsc \
  --checkJs \
  --declaration \
  --emitDeclarationOnly \
  --ignoreConfig \
  --outDir types \
  --rootDir src \
  src/index.js

node_modules/.bin/eslint --fix

node_modules/.bin/tsc

exec node_modules/.bin/esbuild $1 \
  --bundle \
  --jsx-import-source=endr \
  --jsx=automatic \
  --loader:.js=jsx \
  --minify \
  --outfile=docs/dist.js \
  docs/index.js
